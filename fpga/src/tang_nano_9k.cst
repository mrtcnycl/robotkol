// =============================================================================
// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) Pin Kısıtları - Adım (b) + (c): Kamera + HDMI
// =============================================================================

// 1. 27 MHz Kristal Osilatör (Bank 1 - 3.3V)
IO_LOC  "clk_27m"     52;
IO_PORT "clk_27m"     IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 2. Kart Üstü Butonlar (Bank 3 - 1.8V, Basılı = 0, Serbest = 1)
IO_LOC  "btn_s1_n"    3;
IO_PORT "btn_s1_n"    IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "btn_s2_n"    4;
IO_PORT "btn_s2_n"    IO_TYPE=LVCMOS18 PULL_MODE=UP;

// 3. Kart Üstü 6 Adet LED (Bank 3 - 1.8V, Aktif Düşük: 0 = Yanar, 1 = Söner)
IO_LOC  "led[0]"      10;
IO_PORT "led[0]"      IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[1]"      11;
IO_PORT "led[1]"      IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[2]"      13;
IO_PORT "led[2]"      IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[3]"      14;
IO_PORT "led[3]"      IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[4]"      15;
IO_PORT "led[4]"      IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[5]"      16;
IO_PORT "led[5]"      IO_TYPE=LVCMOS18 DRIVE=8;

// 4. OV7670 Kontrol ve Saat Pinleri (Sağ Header - Bank 1/2 - 3.3V)
IO_LOC  "cam_sioc"    25;
IO_PORT "cam_sioc"    IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "cam_siod"    26;
IO_PORT "cam_siod"    IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "cam_vsync"   27;
IO_PORT "cam_vsync"   IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_href"    28;
IO_PORT "cam_href"    IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_pclk"    35;
IO_PORT "cam_pclk"    IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_xclk"    30;
IO_PORT "cam_xclk"    IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "cam_rst_n"   48;
IO_PORT "cam_rst_n"   IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "cam_pwdn"    49;
IO_PORT "cam_pwdn"    IO_TYPE=LVCMOS33 DRIVE=8;

// 5. OV7670 8-Bit Paralel Veri Pinleri D[7:0] (Sol Header - Bank 1/2 - 3.3V)
IO_LOC  "cam_data[7]" 31;
IO_PORT "cam_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_data[6]" 32;
IO_PORT "cam_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_data[5]" 33;
IO_PORT "cam_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_data[4]" 34;
IO_PORT "cam_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_data[3]" 40;
IO_PORT "cam_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_data[2]" 41;
IO_PORT "cam_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_data[1]" 42;
IO_PORT "cam_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cam_data[0]" 51;
IO_PORT "cam_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// 6. HDMI (TMDS) Diferansiyel Çıkış Pinleri (Bank 1 - ELVDS)
IO_LOC  "tmds_clk_p"  69,68;
IO_PORT "tmds_clk_p"  PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_d_p[0]" 71,70;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_d_p[1]" 73,72;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_d_p[2]" 75,74;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

// 7. BL702 USB-UART Köprüsü Pinleri (Bank 2 - 3.3V)
IO_LOC  "uart_tx"     17;
IO_PORT "uart_tx"     IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "uart_rx"     18;
IO_PORT "uart_rx"     IO_TYPE=LVCMOS33 PULL_MODE=UP;
